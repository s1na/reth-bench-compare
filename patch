+    fn get_jwt_secret_path(&self) -> PathBuf {
+        // For reth, use the CLI args JWT path (default reth convention)
+        if let Some(ref datadir) = self.datadir {
+            // Use same logic as CLI: <datadir>/<chain>/jwt.hex
